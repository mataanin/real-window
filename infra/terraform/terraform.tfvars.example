# AWS Configuration
region      = "us-east-1"
name_prefix = "pl"

# Instance Configuration
instance_type     = "t3.medium"
root_volume_size  = 20
allocate_elastic_ip = true

# Network Configuration
# vpc_id    = null  # Use default VPC
# subnet_id = null  # Use first available subnet

# SSH Access (optional, prefer SSM Session Manager)
# Leave empty to disable direct SSH and use SSM only
ssh_allowed_cidrs = []  # Or ["1.2.3.4/32"] for direct SSH

# API Access (optional)
# Leave empty to access only via Tailscale (recommended)
api_port          = 8000
api_allowed_cidrs = []  # e.g. ["1.2.3.4/32"] to allow public access

# SSH Key (optional, only needed for SSH-over-SSM or direct SSH)
# key_pair_name   = "my-existing-key"  # Existing key pair in AWS
# public_key_path = "~/.ssh/id_rsa.pub"  # Or path to public key

# Repository Configuration
repo_url = "https://github.com/mataanin/real-window.git"
repo_ref = "main"

# Private Repository Authentication (choose ONE method)
# Method 1: GitHub Token via SSM Parameter Store (RECOMMENDED for security)
# First create the parameter: aws ssm put-parameter --name /property-lookup/github-token --value "ghp_xxx" --type SecureString
# github_token_ssm_parameter = "/property-lookup/github-token"

# Method 2: GitHub Token directly (not recommended, prefer SSM)
# github_token = "ghp_xxxxx"

# Method 3: SSH Deploy Key (for SSH repo URLs)
# github_deploy_key = file("~/.ssh/deploy_key")

# Application Secrets (NEVER COMMIT)
# Generate a secure random token: openssl rand -base64 32
api_token = "your-secure-random-token-here"

# Tailscale (optional but recommended)
# Generate auth key at: https://login.tailscale.com/admin/settings/keys
# tailscale_auth_key = "tskey-auth-xxxxx"

# Residential Proxy (optional, recommended for production)
# proxy = "http://username:password@proxy-host:port"

# Cache Configuration
cache_ttl_hours = 24

# Tags
tags = {
  Environment = "production"
  Owner       = "your-name"
}
